{
  "version": 1,
  "docs": {
    "localIndexEnabled": false,
    "cacheDir": "~/.happy-platform-mcp/docs/servicenow",
    "enableVector": false,
    "embeddingProvider": "none"
  },
  "instances": [
    {
      "name": "dev",
      "url": "https://your-dev-instance.service-now.com",
      "authType": "basic",
      "username": "your_dev_username",
      "credentialRef": "keychain:instance/dev/password",
      "default": true,
      "description": "Development instance"
    },
    {
      "name": "prod",
      "url": "https://your-prod-instance.service-now.com",
      "authType": "oauth",
      "grantType": "client_credentials",
      "clientId": "your_oauth_client_id",
      "credentialRef": "keychain:instance/prod/client-secret",
      "default": false,
      "description": "Production instance with OAuth client credentials"
    }
  ]
}
